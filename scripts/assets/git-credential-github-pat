#!/bin/sh
# git credential helper: serve this container's GitHub PAT to git over stdout.
#
# Reads ONLY ~/.config/github/pat (0600), injected per instance by scripts/cb.
# It deliberately does NOT fall back to $GITHUB_PAT: a stale token exported by a
# shell rc file (e.g. ~/.kiro/secrets.env) would otherwise silently override the
# token this container is supposed to use, producing confusing 403s.
#
# The token is never passed on argv and never written into a remote URL or
# .git/config. If no token is present the helper stays silent, so git falls back
# to its normal behaviour: prompt an interactive user, or fail fast for an agent
# (see /etc/git-agent-guard.sh).

[ "$1" = get ] || exit 0

patfile="$HOME/.config/github/pat"
[ -r "$patfile" ] || exit 0

pat=$(tr -d '\r\n' < "$patfile")
[ -n "$pat" ] || exit 0

# x-access-token is the username GitHub expects when the password is a token.
printf 'username=x-access-token\npassword=%s\n' "$pat"
